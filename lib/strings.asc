// =============================================================================
//  PROTOTIPI E DOCUMENTAZIONE
// =============================================================================

// -----------------------------------------------------------------------------
//  Verifica carattere - testano proprietà di un singolo carattere
// -----------------------------------------------------------------------------
func is_space(c);       // Ritorna 1 se c è spazio/tab/newline/CR, 0 altrimenti
func is_digit(c);       // Ritorna 1 se c è una cifra (0-9), 0 altrimenti
func is_alpha(c);       // Ritorna 1 se c è una lettera (a-z, A-Z), 0 altrimenti
func is_alnum(c);       // Ritorna 1 se c è alfanumerico (lettera o cifra), 0 altrimenti
func is_upper(c);       // Ritorna 1 se c è maiuscolo (A-Z), 0 altrimenti
func is_lower(c);       // Ritorna 1 se c è minuscolo (a-z), 0 altrimenti

// -----------------------------------------------------------------------------
//  Conversioni case - trasformano maiuscole/minuscole
// -----------------------------------------------------------------------------
func char_upper(c);     // Converte un carattere in maiuscolo, ritorna il carattere
func char_lower(c);     // Converte un carattere in minuscolo, ritorna il carattere
func str_upper(s);      // Converte tutta la stringa in maiuscolo
func str_lower(s);      // Converte tutta la stringa in minuscolo
func str_capitalize(s); // Prima lettera maiuscola, resto minuscolo ("hello" -> "Hello")
func str_title(s);      // Ogni parola con iniziale maiuscola ("hello world" -> "Hello World")

// -----------------------------------------------------------------------------
//  Trimming - rimuovono spazi bianchi
// -----------------------------------------------------------------------------
func str_ltrim(s);      // Rimuove spazi a sinistra ("  hi" -> "hi")
func str_rtrim(s);      // Rimuove spazi a destra ("hi  " -> "hi")
func str_trim(s);       // Rimuove spazi da entrambi i lati ("  hi  " -> "hi")

// -----------------------------------------------------------------------------
//  Ricerca - trovano sottostringhe
// -----------------------------------------------------------------------------
func str_index_of(s, sub);      // Posizione prima occorrenza di sub in s, -1 se non trovata
func str_last_index_of(s, sub); // Posizione ultima occorrenza di sub in s, -1 se non trovata
func str_contains(s, sub);      // Ritorna 1 se s contiene sub, 0 altrimenti
func str_starts_with(s, prefix);// Ritorna 1 se s inizia con prefix, 0 altrimenti
func str_ends_with(s, suffix);  // Ritorna 1 se s finisce con suffix, 0 altrimenti
func str_count(s, sub);         // Conta quante volte sub appare in s

// -----------------------------------------------------------------------------
//  Manipolazione - trasformano stringhe
// -----------------------------------------------------------------------------
func str_replace(s, old, new);       // Sostituisce tutte le occorrenze di old con new
func str_replace_first(s, old, new); // Sostituisce solo la prima occorrenza
func str_reverse(s);                 // Inverte la stringa ("hello" -> "olleh")
func str_repeat(s, n);               // Ripete la stringa n volte ("ab", 3 -> "ababab")
func str_pad_left(s, len, c);        // Padding a sinistra fino a len caratteri con c
func str_pad_right(s, len, c);       // Padding a destra fino a len caratteri con c
func str_center(s, len, c);          // Centra la stringa con padding c

// -----------------------------------------------------------------------------
//  Split e Join - dividono e uniscono stringhe
// -----------------------------------------------------------------------------
func str_split(s, delim);    // Divide s usando delim, ritorna array {0: "a", 1: "b", ...}
func str_join(arr, delim);   // Unisce array in stringa con delim tra elementi

// -----------------------------------------------------------------------------
//  Utility - funzioni varie
// -----------------------------------------------------------------------------
func str_is_blank(s);        // Ritorna 1 se s è vuota o solo spazi, 0 altrimenti
func str_is_numeric(s);      // Ritorna 1 se s contiene solo cifre, 0 altrimenti
func str_is_alpha(s);        // Ritorna 1 se s contiene solo lettere, 0 altrimenti
func str_is_alnum(s);        // Ritorna 1 se s contiene solo caratteri alfanumerici
func str_truncate(s, max, suffix); // Tronca a max caratteri aggiungendo suffix se necessario
func str_between(s, start, end);   // Estrae testo tra due delimitatori

// -----------------------------------------------------------------------------
//  Confronto - comparano stringhe
// -----------------------------------------------------------------------------
func str_compare(a, b);             // Confronta: -1 se a<b, 0 se a==b, 1 se a>b
func str_compare_ignore_case(a, b); // Come str_compare ma ignora maiuscole/minuscole
func str_equals_ignore_case(a, b);  // Ritorna 1 se uguali ignorando case, 0 altrimenti

// =============================================================================
//  IMPLEMENTAZIONI
// =============================================================================

// -----------------------------------------------------------------------------
//  COSTANTI CARATTERI
// -----------------------------------------------------------------------------

// Codici ASCII utili
CHAR_SPACE = 32;
CHAR_TAB = 9;
CHAR_NEWLINE = 10;
CHAR_CR = 13;
CHAR_0 = 48;
CHAR_9 = 57;
CHAR_A = 65;
CHAR_Z = 90;
CHAR_a = 97;
CHAR_z = 122;

// -----------------------------------------------------------------------------
//  FUNZIONI DI VERIFICA CARATTERE
// -----------------------------------------------------------------------------

// Verifica se un carattere è uno spazio (space, tab, newline, CR)
func is_space(c) {
    code = to_int(c);
    if (code == CHAR_SPACE || code == CHAR_TAB || code == CHAR_NEWLINE || code == CHAR_CR) {
        return 1;
    }
    return 0;
}

// Verifica se un carattere è una cifra (0-9)
// Nota: to_int("5") ritorna 5, non 53, quindi usiamo confronto diretto
func is_digit(c) {
    if (len(c) != 1) {
        return 0;
    }
    if (c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
        c == "5" || c == "6" || c == "7" || c == "8" || c == "9") {
        return 1;
    }
    return 0;
}

// Verifica se un carattere è una lettera (a-z, A-Z)
func is_alpha(c) {
    code = to_int(c);
    // Evita (A && B) || (C && D) inline - bug del parser
    if (code >= CHAR_A && code <= CHAR_Z) {
        return 1;
    }
    if (code >= CHAR_a && code <= CHAR_z) {
        return 1;
    }
    return 0;
}

// Verifica se un carattere è alfanumerico
func is_alnum(c) {
    if (is_alpha(c)) {
        return 1;
    }
    if (is_digit(c)) {
        return 1;
    }
    return 0;
}

// Verifica se un carattere è maiuscolo
func is_upper(c) {
    code = to_int(c);
    if (code >= CHAR_A && code <= CHAR_Z) {
        return 1;
    }
    return 0;
}

// Verifica se un carattere è minuscolo
func is_lower(c) {
    code = to_int(c);
    if (code >= CHAR_a && code <= CHAR_z) {
        return 1;
    }
    return 0;
}

// -----------------------------------------------------------------------------
//  CONVERSIONI CASE
// -----------------------------------------------------------------------------

// Converte un carattere in maiuscolo
func char_upper(c) {
    code = to_int(c);
    if (code >= CHAR_a && code <= CHAR_z) {
        return chr(code - 32);
    }
    return c;
}

// Converte un carattere in minuscolo
func char_lower(c) {
    code = to_int(c);
    if (code >= CHAR_A && code <= CHAR_Z) {
        return chr(code + 32);
    }
    return c;
}

// Converte tutta la stringa in maiuscolo
func str_upper(s) {
    result = "";
    i = 0;
    n = len(s);
    while (i < n) {
        result = result + char_upper(s[i]);
        i += 1;
    }
    return result;
}

// Converte tutta la stringa in minuscolo
func str_lower(s) {
    result = "";
    i = 0;
    n = len(s);
    while (i < n) {
        result = result + char_lower(s[i]);
        i += 1;
    }
    return result;
}

// Capitalizza la prima lettera
func str_capitalize(s) {
    if (len(s) == 0) {
        return "";
    }
    return char_upper(s[0]) + str_lower(substr(s, 1, len(s) - 1));
}

// Capitalizza ogni parola
func str_title(s) {
    result = "";
    capitalize_next = 1;
    i = 0;
    n = len(s);
    while (i < n) {
        c = s[i];
        if (is_space(c)) {
            result = result + c;
            capitalize_next = 1;
        } else {
            if (capitalize_next) {
                result = result + char_upper(c);
                capitalize_next = 0;
            } else {
                result = result + char_lower(c);
            }
        }
        i += 1;
    }
    return result;
}

// -----------------------------------------------------------------------------
//  TRIMMING
// -----------------------------------------------------------------------------

// Rimuove spazi a sinistra
func str_ltrim(s) {
    n = len(s);
    start = 0;
    // No short-circuit in Ascension - usa while con check separato
    while (start < n) {
        if (!is_space(s[start])) {
            // Trovato primo non-space, esci
            return substr(s, start, n - start);
        }
        start += 1;
    }
    return "";
}

// Rimuove spazi a destra
func str_rtrim(s) {
    n = len(s);
    end = n;
    // No short-circuit in Ascension - usa while con check separato
    while (end > 0) {
        if (!is_space(s[end - 1])) {
            // Trovato primo non-space da destra, esci
            return substr(s, 0, end);
        }
        end -= 1;
    }
    return "";
}

// Rimuove spazi da entrambi i lati
func str_trim(s) {
    return str_ltrim(str_rtrim(s));
}

// -----------------------------------------------------------------------------
//  RICERCA
// -----------------------------------------------------------------------------

// Trova la prima occorrenza di sub in s, ritorna -1 se non trovata
func str_index_of(s, sub) {
    s_len = len(s);
    sub_len = len(sub);

    if (sub_len == 0) {
        return 0;
    }
    if (sub_len > s_len) {
        return -1;
    }

    i = 0;
    limit = s_len - sub_len + 1;
    while (i < limit) {
        found = 1;
        j = 0;
        while (j < sub_len && found) {
            if (s[i + j] != sub[j]) {
                found = 0;
            }
            j += 1;
        }
        if (found) {
            return i;
        }
        i += 1;
    }
    return -1;
}

// Trova l'ultima occorrenza di sub in s
func str_last_index_of(s, sub) {
    s_len = len(s);
    sub_len = len(sub);

    if (sub_len == 0) {
        return s_len;
    }
    if (sub_len > s_len) {
        return -1;
    }

    last_found = -1;
    i = 0;
    limit = s_len - sub_len + 1;
    while (i < limit) {
        found = 1;
        j = 0;
        while (j < sub_len && found) {
            if (s[i + j] != sub[j]) {
                found = 0;
            }
            j += 1;
        }
        if (found) {
            last_found = i;
        }
        i += 1;
    }
    return last_found;
}

// Verifica se la stringa contiene una sottostringa
func str_contains(s, sub) {
    if (str_index_of(s, sub) >= 0) {
        return 1;
    }
    return 0;
}

// Verifica se la stringa inizia con prefix
func str_starts_with(s, prefix) {
    if (len(prefix) > len(s)) {
        return 0;
    }
    return substr(s, 0, len(prefix)) == prefix;
}

// Verifica se la stringa finisce con suffix
func str_ends_with(s, suffix) {
    s_len = len(s);
    suffix_len = len(suffix);
    if (suffix_len > s_len) {
        return 0;
    }
    return substr(s, s_len - suffix_len, suffix_len) == suffix;
}

// Conta le occorrenze di sub in s
func str_count(s, sub) {
    count = 0;
    sub_len = len(sub);
    if (sub_len == 0) {
        return 0;
    }

    pos = str_index_of(s, sub);
    while (pos >= 0) {
        count += 1;
        // Cerca dalla posizione successiva
        remaining = substr(s, pos + sub_len, len(s) - pos - sub_len);
        next_pos = str_index_of(remaining, sub);
        if (next_pos >= 0) {
            pos = pos + sub_len + next_pos;
        } else {
            pos = -1;
        }
    }
    return count;
}

// -----------------------------------------------------------------------------
//  MANIPOLAZIONE
// -----------------------------------------------------------------------------

// Sostituisce tutte le occorrenze di old con new
func str_replace(s, old, new) {
    result = "";
    old_len = len(old);

    if (old_len == 0) {
        return s;
    }

    pos = str_index_of(s, old);
    while (pos >= 0) {
        result = result + substr(s, 0, pos) + new;
        s = substr(s, pos + old_len, len(s) - pos - old_len);
        pos = str_index_of(s, old);
    }
    result = result + s;
    return result;
}

// Sostituisce solo la prima occorrenza
func str_replace_first(s, old, new) {
    pos = str_index_of(s, old);
    if (pos < 0) {
        return s;
    }
    old_len = len(old);
    s_len = len(s);
    // Costruisci il risultato passo passo per compatibilità C++
    left = substr(s, 0, pos);
    right = substr(s, pos + old_len, s_len - pos - old_len);
    result = left + new + right;
    return result;
}

// Inverte la stringa
func str_reverse(s) {
    result = "";
    i = len(s) - 1;
    while (i >= 0) {
        result = result + s[i];
        i -= 1;
    }
    return result;
}

// Ripete la stringa n volte
func str_repeat(s, n) {
    result = "";
    i = 0;
    while (i < n) {
        result = result + s;
        i += 1;
    }
    return result;
}

// Padding a sinistra fino a raggiungere lunghezza target
func str_pad_left(s, target_len, pad_char) {
    current_len = len(s);
    if (current_len >= target_len) {
        return s;
    }
    padding = str_repeat(pad_char, target_len - current_len);
    return padding + s;
}

// Padding a destra fino a raggiungere lunghezza target
func str_pad_right(s, target_len, pad_char) {
    current_len = len(s);
    if (current_len >= target_len) {
        return s;
    }
    padding = str_repeat(pad_char, target_len - current_len);
    return s + padding;
}

// Centra la stringa con padding
func str_center(s, target_len, pad_char) {
    current_len = len(s);
    if (current_len >= target_len) {
        return s;
    }
    total_pad = target_len - current_len;
    left_pad = total_pad / 2;
    right_pad = total_pad - left_pad;
    // Costruisci passo passo per compatibilità C++
    left_str = str_repeat(pad_char, left_pad);
    right_str = str_repeat(pad_char, right_pad);
    result = left_str + s + right_str;
    return result;
}

// -----------------------------------------------------------------------------
//  SPLIT E JOIN
// -----------------------------------------------------------------------------

// Divide la stringa in un array usando il delimitatore
// Ritorna un array con indici 0, 1, 2...
func str_split(s, delimiter) {
    result = {};
    index = 0;
    delim_len = len(delimiter);

    if (delim_len == 0) {
        // Se delimitatore vuoto, splitta ogni carattere
        i = 0;
        n = len(s);
        while (i < n) {
            result[index] = s[i];
            index += 1;
            i += 1;
        }
        return result;
    }

    pos = str_index_of(s, delimiter);
    while (pos >= 0) {
        result[index] = substr(s, 0, pos);
        index += 1;
        s = substr(s, pos + delim_len, len(s) - pos - delim_len);
        pos = str_index_of(s, delimiter);
    }
    result[index] = s;
    return result;
}

// Unisce un array in una stringa usando il delimitatore
func str_join(arr, delimiter) {
    result = "";
    n = len(arr);
    i = 0;
    while (i < n) {
        if (i > 0) {
            result = result + delimiter;
        }
        result = result + arr[i];
        i += 1;
    }
    return result;
}

// -----------------------------------------------------------------------------
//  UTILITÀ VARIE
// -----------------------------------------------------------------------------

// Verifica se la stringa è vuota o contiene solo spazi
func str_is_blank(s) {
    return len(str_trim(s)) == 0;
}

// Verifica se la stringa è composta solo da cifre
func str_is_numeric(s) {
    if (len(s) == 0) {
        return 0;
    }
    i = 0;
    n = len(s);
    while (i < n) {
        if (!is_digit(s[i])) {
            return 0;
        }
        i += 1;
    }
    return 1;
}

// Verifica se la stringa è composta solo da lettere
func str_is_alpha(s) {
    if (len(s) == 0) {
        return 0;
    }
    i = 0;
    n = len(s);
    while (i < n) {
        if (!is_alpha(s[i])) {
            return 0;
        }
        i += 1;
    }
    return 1;
}

// Verifica se la stringa è composta solo da caratteri alfanumerici
func str_is_alnum(s) {
    if (len(s) == 0) {
        return 0;
    }
    i = 0;
    n = len(s);
    while (i < n) {
        if (!is_alnum(s[i])) {
            return 0;
        }
        i += 1;
    }
    return 1;
}

// Tronca la stringa a max_len caratteri, aggiungendo suffix se troncata
func str_truncate(s, max_len, suffix) {
    if (len(s) <= max_len) {
        return s;
    }
    suffix_len = len(suffix);
    if (max_len <= suffix_len) {
        return substr(s, 0, max_len);
    }
    return substr(s, 0, max_len - suffix_len) + suffix;
}

// Estrae una sottostringa tra due delimitatori
func str_between(s, start_delim, end_delim) {
    start_pos = str_index_of(s, start_delim);
    if (start_pos < 0) {
        return "";
    }
    start_pos = start_pos + len(start_delim);
    remaining = substr(s, start_pos, len(s) - start_pos);
    end_pos = str_index_of(remaining, end_delim);
    if (end_pos < 0) {
        return remaining;
    }
    return substr(remaining, 0, end_pos);
}

// Confronta due stringhe (case-sensitive)
// Ritorna: -1 se a < b, 0 se a == b, 1 se a > b
func str_compare(a, b) {
    len_a = len(a);
    len_b = len(b);
    min_len = len_a;
    if (len_b < min_len) {
        min_len = len_b;
    }

    i = 0;
    while (i < min_len) {
        code_a = to_int(a[i]);
        code_b = to_int(b[i]);
        if (code_a < code_b) {
            return -1;
        }
        if (code_a > code_b) {
            return 1;
        }
        i += 1;
    }

    if (len_a < len_b) {
        return -1;
    }
    if (len_a > len_b) {
        return 1;
    }
    return 0;
}

// Confronta due stringhe ignorando il case
func str_compare_ignore_case(a, b) {
    return str_compare(str_lower(a), str_lower(b));
}

// Verifica uguaglianza ignorando il case
func str_equals_ignore_case(a, b) {
    return str_lower(a) == str_lower(b);
}
