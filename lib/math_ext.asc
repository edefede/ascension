//
//  NOTA: Questa libreria estende le funzioni built-in di Ascension 12.7+
//  Built-in già disponibili: sqrt, pow, exp, log, abs, floor, ceil,
//                            sin, cos, tan, asin, acos, atan, atan2,
//                            random, PI, E
//
//  INDICE FUNZIONI:
//  -----------------
//  CONFRONTO:
//    min(a, b)                  - Ritorna il minore tra due valori
//    max(a, b)                  - Ritorna il maggiore tra due valori
//    clamp(val, min_v, max_v)   - Limita val nell'intervallo [min_v, max_v]
//
//  ARROTONDAMENTO:
//    round(x)                   - Arrotonda al più vicino intero
//    trunc(x)                   - Tronca verso zero
//    sign(x)                    - Ritorna -1, 0, o 1
//
//  ARITMETICA:
//    gcd(a, b)                  - Massimo comune divisore
//    lcm(a, b)                  - Minimo comune multiplo
//    factorial(n)               - Fattoriale (n!)
//    fibonacci(n)               - N-esimo numero di Fibonacci
//    is_even(n)                 - Verifica se pari
//    is_odd(n)                  - Verifica se dispari
//
//  NUMERI PRIMI:
//    is_prime(n)                - Verifica se n è primo
//    next_prime(n)              - Trova il primo successivo a n
//    prime_factors(n)           - Fattorizzazione in primi (ritorna array)
//
//  POTENZE E LOGARITMI:
//    log10(x)                   - Logaritmo in base 10
//    log2(x)                    - Logaritmo in base 2
//    logn(x, base)              - Logaritmo in base arbitraria
//    is_power_of_2(n)           - Verifica se n è potenza di 2
//
//  TRIGONOMETRIA ESTESA:
//    deg_to_rad(deg)            - Converte gradi in radianti
//    rad_to_deg(rad)            - Converte radianti in gradi
//    hypot(a, b)                - Ipotenusa: sqrt(a² + b²)
//
//  STATISTICA BASE:
//    lerp(a, b, t)              - Interpolazione lineare
//    map_range(val, in_min, in_max, out_min, out_max) - Rimappa valore
//
//  COMBINATORIA:
//    permutations(n, k)         - Permutazioni: n! / (n-k)!
//    combinations(n, k)         - Combinazioni: n! / (k! * (n-k)!)
//
// =============================================================================

// -----------------------------------------------------------------------------
//  FUNZIONI DI CONFRONTO
// -----------------------------------------------------------------------------

// Ritorna il minore tra due valori
func min(a, b) {
    if (a < b) {
        return a;
    }
    return b;
}

// Ritorna il maggiore tra due valori
func max(a, b) {
    if (a > b) {
        return a;
    }
    return b;
}

// Limita val nell'intervallo [min_v, max_v]
func clamp(val, min_v, max_v) {
    if (val < min_v) {
        return min_v;
    }
    if (val > max_v) {
        return max_v;
    }
    return val;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI ARROTONDAMENTO
// -----------------------------------------------------------------------------

// Arrotonda al più vicino intero
// 2.4 -> 2, 2.5 -> 3, 2.6 -> 3, -2.5 -> -2
func round(x) {
    if (x >= 0) {
        return floor(x + 0.5);
    }
    return ceil(x - 0.5);
}

// Tronca verso zero (rimuove parte decimale)
// 2.7 -> 2, -2.7 -> -2
func trunc(x) {
    if (x >= 0) {
        return floor(x);
    }
    return ceil(x);
}

// Ritorna il segno: -1 se negativo, 0 se zero, 1 se positivo
func sign(x) {
    if (x < 0) {
        return -1;
    }
    if (x > 0) {
        return 1;
    }
    return 0;
}

// -----------------------------------------------------------------------------
//  FUNZIONI ARITMETICHE
// -----------------------------------------------------------------------------

// Massimo comune divisore (algoritmo di Euclide)
func gcd(a, b) {
    // Lavora con valori assoluti
    if (a < 0) {
        a = 0 - a;
    }
    if (b < 0) {
        b = 0 - b;
    }
    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// Minimo comune multiplo
func lcm(a, b) {
    if (a == 0) {
        return 0;
    }
    if (b == 0) {
        return 0;
    }
    // Usa valori assoluti
    abs_a = a;
    abs_b = b;
    if (abs_a < 0) {
        abs_a = 0 - abs_a;
    }
    if (abs_b < 0) {
        abs_b = 0 - abs_b;
    }
    return (abs_a * abs_b) / gcd(a, b);
}

// Fattoriale (n!)
// 0! = 1, 1! = 1, 5! = 120
func factorial(n) {
    if (n < 0) {
        return NULL;
    }
    if (n <= 1) {
        return 1;
    }
    result = 1;
    for (i = 2; i <= n; i = i + 1) {
        result = result * i;
    }
    return result;
}

// N-esimo numero di Fibonacci
// fib(0) = 0, fib(1) = 1, fib(2) = 1, fib(3) = 2, ...
func fibonacci(n) {
    if (n < 0) {
        return NULL;
    }
    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    a = 0;
    b = 1;
    for (i = 2; i <= n; i = i + 1) {
        temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

// Verifica se n è pari
func is_even(n) {
    if (n % 2 == 0) {
        return 1;
    }
    return 0;
}

// Verifica se n è dispari
func is_odd(n) {
    if (n % 2 != 0) {
        return 1;
    }
    return 0;
}

// -----------------------------------------------------------------------------
//  NUMERI PRIMI
// -----------------------------------------------------------------------------

// Verifica se n è un numero primo
func is_prime(n) {
    if (n < 2) {
        return 0;
    }
    if (n == 2) {
        return 1;
    }
    if (n % 2 == 0) {
        return 0;
    }
    // Controlla divisori dispari fino a sqrt(n)
    limit = floor(sqrt(n)) + 1;
    i = 3;
    while (i < limit) {
        if (n % i == 0) {
            return 0;
        }
        i = i + 2;
    }
    return 1;
}

// Trova il primo numero primo maggiore di n
func next_prime(n) {
    candidate = n + 1;
    // Se pari, passa al dispari successivo (tranne per 2)
    if (candidate == 2) {
        return 2;
    }
    if (candidate % 2 == 0) {
        candidate = candidate + 1;
    }
    while (is_prime(candidate) == 0) {
        candidate = candidate + 2;
    }
    return candidate;
}

// Fattorizzazione in numeri primi
// Ritorna un array con i fattori primi (con ripetizioni)
// Es: prime_factors(12) -> [2, 2, 3]
func prime_factors(n) {
    result = {};
    idx = 0;
    
    if (n < 2) {
        return result;
    }
    
    // Estrai tutti i fattori 2
    while (n % 2 == 0) {
        result[idx] = 2;
        idx = idx + 1;
        n = n / 2;
    }
    
    // Controlla i fattori dispari
    i = 3;
    while (i * i <= n) {
        while (n % i == 0) {
            result[idx] = i;
            idx = idx + 1;
            n = n / i;
        }
        i = i + 2;
    }
    
    // Se n > 1, allora è un fattore primo
    if (n > 1) {
        result[idx] = n;
    }
    
    return result;
}

// -----------------------------------------------------------------------------
//  POTENZE E LOGARITMI
// -----------------------------------------------------------------------------

// Logaritmo in base 10
func log10(x) {
    if (x <= 0) {
        return NULL;
    }
    return log(x) / log(10);
}

// Logaritmo in base 2
func log2(x) {
    if (x <= 0) {
        return NULL;
    }
    return log(x) / log(2);
}

// Logaritmo in base arbitraria
func logn(x, base) {
    if (x <= 0) {
        return NULL;
    }
    if (base <= 0) {
        return NULL;
    }
    if (base == 1) {
        return NULL;
    }
    return log(x) / log(base);
}

// Verifica se n è una potenza di 2
// 1, 2, 4, 8, 16, 32, ... sono potenze di 2
func is_power_of_2(n) {
    if (n <= 0) {
        return 0;
    }
    // Una potenza di 2 ha un solo bit a 1
    // n & (n-1) == 0 per potenze di 2
    // Implementazione senza operatori bitwise
    while (n > 1) {
        if (n % 2 != 0) {
            return 0;
        }
        n = n / 2;
    }
    return 1;
}

// -----------------------------------------------------------------------------
//  TRIGONOMETRIA ESTESA
// -----------------------------------------------------------------------------

// Converte gradi in radianti
func deg_to_rad(deg) {
    return deg * PI / 180;
}

// Converte radianti in gradi
func rad_to_deg(rad) {
    return rad * 180 / PI;
}

// Calcola l'ipotenusa: sqrt(a² + b²)
// Utile per calcolare distanze
func hypot(a, b) {
    return sqrt(a * a + b * b);
}

// -----------------------------------------------------------------------------
//  STATISTICA BASE
// -----------------------------------------------------------------------------

// Interpolazione lineare tra a e b
// t=0 -> a, t=1 -> b, t=0.5 -> punto medio
func lerp(a, b, t) {
    return a + (b - a) * t;
}

// Rimappa un valore da un intervallo a un altro
// Es: map_range(5, 0, 10, 0, 100) = 50
func map_range(val, in_min, in_max, out_min, out_max) {
    // Normalizza val nell'intervallo [0, 1]
    normalized = (val - in_min) / (in_max - in_min);
    // Scala all'intervallo di output
    return out_min + normalized * (out_max - out_min);
}

// -----------------------------------------------------------------------------
//  COMBINATORIA
// -----------------------------------------------------------------------------

// Permutazioni: P(n,k) = n! / (n-k)!
// Quanti modi per ordinare k elementi da n
func permutations(n, k) {
    if (k < 0) {
        return 0;
    }
    if (k > n) {
        return 0;
    }
    if (n < 0) {
        return 0;
    }
    result = 1;
    for (i = 0; i < k; i = i + 1) {
        result = result * (n - i);
    }
    return result;
}

// Combinazioni: C(n,k) = n! / (k! * (n-k)!)
// Quanti modi per scegliere k elementi da n (ordine non conta)
func combinations(n, k) {
    if (k < 0) {
        return 0;
    }
    if (k > n) {
        return 0;
    }
    if (n < 0) {
        return 0;
    }
    // Ottimizzazione: C(n,k) = C(n, n-k)
    if (k > n - k) {
        k = n - k;
    }
    result = 1;
    for (i = 0; i < k; i = i + 1) {
        result = result * (n - i);
        result = result / (i + 1);
    }
    return result;
}

