// =============================================================================
//
//  INDICE FUNZIONI:
//  -----------------
//  INFORMAZIONI:
//    array_length(arr)              - Ritorna il numero di elementi
//    array_is_empty(arr)            - Verifica se l'array è vuoto
//    array_has_key(arr, key)        - Verifica se esiste una chiave
//
//  ACCESSO:
//    array_first(arr)               - Ritorna il primo elemento
//    array_last(arr)                - Ritorna l'ultimo elemento
//    array_get(arr, idx, default)   - Ritorna elemento o default se non esiste
//
//  MODIFICA:
//    array_push(arr, val)           - Aggiunge elemento in coda
//    array_pop(arr)                 - Rimuove e ritorna l'ultimo elemento
//    array_unshift(arr, val)        - Aggiunge elemento in testa
//    array_shift(arr)               - Rimuove e ritorna il primo elemento
//    array_insert(arr, idx, val)    - Inserisce elemento alla posizione idx
//    array_remove(arr, idx)         - Rimuove elemento alla posizione idx
//    array_clear(arr)               - Svuota l'array
//
//  RICERCA:
//    array_find(arr, val)           - Trova indice di val, ritorna -1 se non trovato
//    array_contains(arr, val)       - Verifica se val è presente (1/0)
//    array_count(arr, val)          - Conta occorrenze di val
//
//  TRASFORMAZIONE:
//    array_reverse(arr)             - Inverte l'ordine degli elementi
//    array_slice(arr, start, end)   - Estrae porzione [start, end)
//    array_copy(arr)                - Crea copia superficiale
//    array_merge(arr1, arr2)        - Unisce due array
//    array_unique(arr)              - Rimuove duplicati
//
//  CREAZIONE:
//    array_fill(size, val)          - Crea array di size elementi con valore val
//    array_range(start, end)        - Crea array [start, start+1, ..., end-1]
//    array_range_step(start,end,step) - Crea array con passo personalizzato
//
//  AGGREGAZIONE:
//    array_sum(arr)                 - Somma tutti gli elementi
//    array_product(arr)             - Prodotto di tutti gli elementi
//    array_min(arr)                 - Valore minimo
//    array_max(arr)                 - Valore massimo
//    array_avg(arr)                 - Media aritmetica
//
// =============================================================================

// -----------------------------------------------------------------------------
//  FUNZIONI INFORMATIVE
// -----------------------------------------------------------------------------

// Ritorna il numero di elementi nell'array
// Gli array in Ascension sono dict con chiavi numeriche
// Nota: elementi NULL non vengono contati (sono considerati "rimossi")
func array_length(arr) {
    count = 0;
    k = keys(arr);
    klen = len(k);
    for (i = 0; i < klen; i = i + 1) {
        key = k[i];
        val = arr[key];
        // Non contare elementi NULL (rimossi)
        if (val != NULL) {
            count = count + 1;
        }
    }
    return count;
}

// Verifica se l'array è vuoto
func array_is_empty(arr) {
    if (array_length(arr) == 0) {
        return 1;
    }
    return 0;
}

// Verifica se una chiave esiste nell'array
func array_has_key(arr, key) {
    k = keys(arr);
    klen = len(k);
    for (i = 0; i < klen; i = i + 1) {
        if (k[i] == key) {
            return 1;
        }
    }
    return 0;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI ACCESSO
// -----------------------------------------------------------------------------

// Ritorna il primo elemento (indice 0)
func array_first(arr) {
    if (array_is_empty(arr)) {
        return NULL;
    }
    return arr[0];
}

// Ritorna l'ultimo elemento
func array_last(arr) {
    length = array_length(arr);
    if (length == 0) {
        return NULL;
    }
    return arr[length - 1];
}

// Ritorna elemento o valore default se non esiste
func array_get(arr, idx, default_val) {
    if (array_has_key(arr, idx)) {
        return arr[idx];
    }
    return default_val;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI MODIFICA
// -----------------------------------------------------------------------------

// Aggiunge elemento in coda all'array
// Ritorna la nuova lunghezza
func array_push(arr, val) {
    length = array_length(arr);
    arr[length] = val;
    return length + 1;
}

// Rimuove e ritorna l'ultimo elemento
// Ritorna NULL se array vuoto
func array_pop(arr) {
    length = array_length(arr);
    if (length == 0) {
        return NULL;
    }
    last_idx = length - 1;
    val = arr[last_idx];
    // Rimuoviamo l'elemento impostando a NULL
    // Nota: in Ascension non c'è delete, ma possiamo ricostruire
    arr[last_idx] = NULL;
    return val;
}

// Aggiunge elemento in testa (posizione 0)
// Sposta tutti gli altri elementi
// Ritorna la nuova lunghezza
func array_unshift(arr, val) {
    length = array_length(arr);
    // Sposta tutti gli elementi di una posizione
    for (i = length; i > 0; i = i - 1) {
        arr[i] = arr[i - 1];
    }
    arr[0] = val;
    return length + 1;
}

// Rimuove e ritorna il primo elemento
// Sposta tutti gli altri elementi
func array_shift(arr) {
    length = array_length(arr);
    if (length == 0) {
        return NULL;
    }
    val = arr[0];
    // Sposta tutti gli elementi indietro di una posizione
    for (i = 0; i < length - 1; i = i + 1) {
        arr[i] = arr[i + 1];
    }
    // Rimuove l'ultimo (duplicato)
    arr[length - 1] = NULL;
    return val;
}

// Inserisce elemento alla posizione idx
// Sposta gli elementi successivi
func array_insert(arr, idx, val) {
    length = array_length(arr);
    // Se idx >= length, equivale a push
    if (idx >= length) {
        arr[length] = val;
        return length + 1;
    }
    // Sposta elementi da idx in poi
    for (i = length; i > idx; i = i - 1) {
        arr[i] = arr[i - 1];
    }
    arr[idx] = val;
    return length + 1;
}

// Rimuove elemento alla posizione idx
// Sposta gli elementi successivi
// Ritorna l'elemento rimosso
func array_remove(arr, idx) {
    length = array_length(arr);
    if (idx < 0) {
        return NULL;
    }
    if (idx >= length) {
        return NULL;
    }
    val = arr[idx];
    // Sposta elementi indietro
    for (i = idx; i < length - 1; i = i + 1) {
        arr[i] = arr[i + 1];
    }
    arr[length - 1] = NULL;
    return val;
}

// Svuota l'array
// Nota: in Ascension impostiamo tutti gli elementi a NULL
func array_clear(arr) {
    length = array_length(arr);
    for (i = 0; i < length; i = i + 1) {
        arr[i] = NULL;
    }
    return 1;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI RICERCA
// -----------------------------------------------------------------------------

// Trova l'indice della prima occorrenza di val
// Ritorna -1 se non trovato
func array_find(arr, val) {
    length = array_length(arr);
    for (i = 0; i < length; i = i + 1) {
        if (arr[i] == val) {
            return i;
        }
    }
    return -1;
}

// Verifica se val è presente nell'array
// Ritorna 1 se presente, 0 altrimenti
func array_contains(arr, val) {
    if (array_find(arr, val) >= 0) {
        return 1;
    }
    return 0;
}

// Conta le occorrenze di val nell'array
func array_count(arr, val) {
    count = 0;
    length = array_length(arr);
    for (i = 0; i < length; i = i + 1) {
        if (arr[i] == val) {
            count = count + 1;
        }
    }
    return count;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI TRASFORMAZIONE
// -----------------------------------------------------------------------------

// Inverte l'ordine degli elementi
// Modifica l'array in place e lo ritorna
func array_reverse(arr) {
    length = array_length(arr);
    half = length / 2;
    for (i = 0; i < half; i = i + 1) {
        j = length - 1 - i;
        // Swap
        temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }
    return arr;
}

// Estrae una porzione dell'array [start, end)
// Ritorna un nuovo array
func array_slice(arr, start, end) {
    result = {};
    length = array_length(arr);
    
    // Normalizza indici
    if (start < 0) {
        start = 0;
    }
    if (end > length) {
        end = length;
    }
    if (start >= end) {
        return result;
    }
    
    idx = 0;
    for (i = start; i < end; i = i + 1) {
        result[idx] = arr[i];
        idx = idx + 1;
    }
    return result;
}

// Crea una copia superficiale dell'array
func array_copy(arr) {
    result = {};
    length = array_length(arr);
    for (i = 0; i < length; i = i + 1) {
        result[i] = arr[i];
    }
    return result;
}

// Unisce due array
// Ritorna un nuovo array con elementi di arr1 seguiti da arr2
func array_merge(arr1, arr2) {
    result = {};
    len1 = array_length(arr1);
    len2 = array_length(arr2);
    
    idx = 0;
    for (i = 0; i < len1; i = i + 1) {
        result[idx] = arr1[i];
        idx = idx + 1;
    }
    for (i = 0; i < len2; i = i + 1) {
        result[idx] = arr2[i];
        idx = idx + 1;
    }
    return result;
}

// Rimuove elementi duplicati
// Ritorna un nuovo array con solo elementi unici
func array_unique(arr) {
    result = {};
    result_len = 0;
    length = array_length(arr);
    
    for (i = 0; i < length; i = i + 1) {
        val = arr[i];
        // Verifica se già presente in result
        found = 0;
        for (j = 0; j < result_len; j = j + 1) {
            if (result[j] == val) {
                found = 1;
                break;
            }
        }
        if (found == 0) {
            result[result_len] = val;
            result_len = result_len + 1;
        }
    }
    return result;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI CREAZIONE
// -----------------------------------------------------------------------------

// Crea un array di size elementi tutti inizializzati a val
func array_fill(size, val) {
    result = {};
    for (i = 0; i < size; i = i + 1) {
        result[i] = val;
    }
    return result;
}

// Crea un array con valori da start a end-1
// Es: array_range(0, 5) -> [0, 1, 2, 3, 4]
func array_range(start, end) {
    result = {};
    idx = 0;
    for (i = start; i < end; i = i + 1) {
        result[idx] = i;
        idx = idx + 1;
    }
    return result;
}

// Crea un array con valori da start a end-1 con passo step
// Es: array_range_step(0, 10, 2) -> [0, 2, 4, 6, 8]
func array_range_step(start, end, step) {
    result = {};
    idx = 0;
    if (step > 0) {
        i = start;
        while (i < end) {
            result[idx] = i;
            idx = idx + 1;
            i = i + step;
        }
    }
    if (step < 0) {
        i = start;
        while (i > end) {
            result[idx] = i;
            idx = idx + 1;
            i = i + step;
        }
    }
    return result;
}

// -----------------------------------------------------------------------------
//  FUNZIONI DI AGGREGAZIONE
// -----------------------------------------------------------------------------

// Somma tutti gli elementi dell'array
func array_sum(arr) {
    total = 0;
    length = array_length(arr);
    for (i = 0; i < length; i = i + 1) {
        total = total + arr[i];
    }
    return total;
}

// Prodotto di tutti gli elementi dell'array
func array_product(arr) {
    length = array_length(arr);
    if (length == 0) {
        return 0;
    }
    total = 1;
    for (i = 0; i < length; i = i + 1) {
        total = total * arr[i];
    }
    return total;
}

// Trova il valore minimo nell'array
func array_min(arr) {
    length = array_length(arr);
    if (length == 0) {
        return NULL;
    }
    min_val = arr[0];
    for (i = 1; i < length; i = i + 1) {
        if (arr[i] < min_val) {
            min_val = arr[i];
        }
    }
    return min_val;
}

// Trova il valore massimo nell'array
func array_max(arr) {
    length = array_length(arr);
    if (length == 0) {
        return NULL;
    }
    max_val = arr[0];
    for (i = 1; i < length; i = i + 1) {
        if (arr[i] > max_val) {
            max_val = arr[i];
        }
    }
    return max_val;
}

// Calcola la media aritmetica degli elementi
func array_avg(arr) {
    length = array_length(arr);
    if (length == 0) {
        return 0;
    }
    return array_sum(arr) / length;
}

// =============================================================================
