// =============================================================================
//  TEST STRING LIBRARY
//  Verifica funzionamento di strings.asc
// =============================================================================

include "strings.asc";

// Utility per i test
passed = 0;
failed = 0;

func test(name, result, expected) {
    if (result == expected) {
        print("✓ PASS:", name);
        global passed = passed + 1;
    } else {
        print("✗ FAIL:", name);
        print("  Expected:", expected);
        print("  Got:", result);
        global failed = failed + 1;
    }
}

print("=== STRING LIBRARY TEST SUITE ===");
print("");

// -----------------------------------------------------------------------------
print("--- Test funzioni carattere ---");
// -----------------------------------------------------------------------------

test("is_space(' ')", is_space(" "), 1);
test("is_space('a')", is_space("a"), 0);
test("is_digit('5')", is_digit("5"), 1);
test("is_digit('x')", is_digit("x"), 0);
test("is_alpha('A')", is_alpha("A"), 1);
test("is_alpha('z')", is_alpha("z"), 1);
test("is_alpha('3')", is_alpha("3"), 0);
test("is_alnum('A')", is_alnum("A"), 1);
test("is_alnum('5')", is_alnum("5"), 1);
test("is_alnum('!')", is_alnum("!"), 0);
test("is_upper('A')", is_upper("A"), 1);
test("is_upper('a')", is_upper("a"), 0);
test("is_lower('a')", is_lower("a"), 1);
test("is_lower('A')", is_lower("A"), 0);

print("");

// -----------------------------------------------------------------------------
print("--- Test conversioni case ---");
// -----------------------------------------------------------------------------

test("char_upper('a')", char_upper("a"), "A");
test("char_upper('A')", char_upper("A"), "A");
test("char_upper('5')", char_upper("5"), "5");
test("char_lower('A')", char_lower("A"), "a");
test("char_lower('a')", char_lower("a"), "a");
test("str_upper('Hello')", str_upper("Hello"), "HELLO");
test("str_lower('Hello')", str_lower("Hello"), "hello");
test("str_capitalize('hello')", str_capitalize("hello"), "Hello");
test("str_capitalize('HELLO')", str_capitalize("HELLO"), "Hello");
test("str_title('hello world')", str_title("hello world"), "Hello World");

print("");

// -----------------------------------------------------------------------------
print("--- Test trimming ---");
// -----------------------------------------------------------------------------

test("str_ltrim('  hello')", str_ltrim("  hello"), "hello");
test("str_rtrim('hello  ')", str_rtrim("hello  "), "hello");
test("str_trim('  hello  ')", str_trim("  hello  "), "hello");
test("str_trim('hello')", str_trim("hello"), "hello");

print("");

// -----------------------------------------------------------------------------
print("--- Test ricerca ---");
// -----------------------------------------------------------------------------

test("str_index_of('hello', 'l')", str_index_of("hello", "l"), 2);
test("str_index_of('hello', 'lo')", str_index_of("hello", "lo"), 3);
test("str_index_of('hello', 'x')", str_index_of("hello", "x"), -1);
test("str_index_of('hello', '')", str_index_of("hello", ""), 0);
test("str_last_index_of('hello', 'l')", str_last_index_of("hello", "l"), 3);
test("str_contains('hello', 'ell')", str_contains("hello", "ell"), 1);
test("str_contains('hello', 'xyz')", str_contains("hello", "xyz"), 0);
test("str_starts_with('hello', 'he')", str_starts_with("hello", "he"), 1);
test("str_starts_with('hello', 'lo')", str_starts_with("hello", "lo"), 0);
test("str_ends_with('hello', 'lo')", str_ends_with("hello", "lo"), 1);
test("str_ends_with('hello', 'he')", str_ends_with("hello", "he"), 0);
test("str_count('banana', 'a')", str_count("banana", "a"), 3);
test("str_count('hello', 'l')", str_count("hello", "l"), 2);

print("");

// -----------------------------------------------------------------------------
print("--- Test manipolazione ---");
// -----------------------------------------------------------------------------

test("str_replace('hello', 'l', 'L')", str_replace("hello", "l", "L"), "heLLo");
test("str_replace('aaa', 'a', 'b')", str_replace("aaa", "a", "b"), "bbb");
test("str_replace_first('hello', 'l', 'L')", str_replace_first("hello", "l", "L"), "heLlo");
test("str_reverse('hello')", str_reverse("hello"), "olleh");
test("str_reverse('a')", str_reverse("a"), "a");
test("str_repeat('ab', 3)", str_repeat("ab", 3), "ababab");
test("str_repeat('x', 0)", str_repeat("x", 0), "");
test("str_pad_left('42', 5, '0')", str_pad_left("42", 5, "0"), "00042");
test("str_pad_right('hi', 5, '.')", str_pad_right("hi", 5, "."), "hi...");
test("str_center('hi', 6, '-')", str_center("hi", 6, "-"), "--hi--");

print("");

// -----------------------------------------------------------------------------
print("--- Test split e join ---");
// -----------------------------------------------------------------------------

parts = str_split("a,b,c", ",");
test("str_split count", len(parts), 3);
test("str_split[0]", parts[0], "a");
test("str_split[1]", parts[1], "b");
test("str_split[2]", parts[2], "c");

arr = {};
arr[0] = "one";
arr[1] = "two";
arr[2] = "three";
test("str_join", str_join(arr, "-"), "one-two-three");

chars = str_split("abc", "");
test("str_split empty delim", len(chars), 3);
test("str_split empty[0]", chars[0], "a");

print("");

// -----------------------------------------------------------------------------
print("--- Test utility ---");
// -----------------------------------------------------------------------------

test("str_is_blank('')", str_is_blank(""), 1);
test("str_is_blank('   ')", str_is_blank("   "), 1);
test("str_is_blank('hi')", str_is_blank("hi"), 0);
test("str_is_numeric('123')", str_is_numeric("123"), 1);
test("str_is_numeric('12a')", str_is_numeric("12a"), 0);
test("str_is_alpha('abc')", str_is_alpha("abc"), 1);
test("str_is_alpha('ab3')", str_is_alpha("ab3"), 0);
test("str_is_alnum('ab3')", str_is_alnum("ab3"), 1);
test("str_is_alnum('ab!')", str_is_alnum("ab!"), 0);
test("str_truncate('hello world', 8, '...')", str_truncate("hello world", 8, "..."), "hello...");
test("str_truncate('hi', 10, '...')", str_truncate("hi", 10, "..."), "hi");
test("str_between('<tag>value</tag>', '<tag>', '</tag>')", str_between("<tag>value</tag>", "<tag>", "</tag>"), "value");

print("");

// -----------------------------------------------------------------------------
print("--- Test confronto ---");
// -----------------------------------------------------------------------------

test("str_compare('abc', 'abd')", str_compare("abc", "abd"), -1);
test("str_compare('abc', 'abc')", str_compare("abc", "abc"), 0);
test("str_compare('abd', 'abc')", str_compare("abd", "abc"), 1);
test("str_compare('ab', 'abc')", str_compare("ab", "abc"), -1);
test("str_equals_ignore_case('Hello', 'HELLO')", str_equals_ignore_case("Hello", "HELLO"), 1);
test("str_equals_ignore_case('Hello', 'World')", str_equals_ignore_case("Hello", "World"), 0);

print("");

// -----------------------------------------------------------------------------
print("=== RISULTATI ===");
print("Passati:", passed);
print("Falliti:", failed);

if (failed == 0) {
    print("✓ Tutti i test passati!");
} else {
    print("✗ Alcuni test sono falliti");
}
