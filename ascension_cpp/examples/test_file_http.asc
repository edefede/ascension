// Test file_open e http_get

print("=== TEST FILE_OPEN ===");

// Test scrittura
f = file_open("test_output.txt", "w");
if (f != NULL) {
    file_write(f, "Hello from Ascension C++!\n");
    file_write(f, "Line 2\n");
    file_close(f);
    print("File scritto con successo");
} else {
    print("Errore apertura file in scrittura");
}

// Test lettura
f = file_open("test_output.txt", "r");
if (f != NULL) {
    content = file_read_all(f);
    file_close(f);
    print("Contenuto file:");
    print(content);
} else {
    print("Errore apertura file in lettura");
}

print("");
print("=== TEST HTTP_GET ===");
print("Tento connessione a httpbin.org...");

response = http_get("http://httpbin.org/get");
if (response != "") {
    print("Risposta ricevuta:");
    // Mostra solo i primi 200 caratteri
    if (len(response) > 200) {
        print(substr(response, 0, 200) + "...");
    } else {
        print(response);
    }
} else {
    print("HTTP GET fallito (network disabilitato o errore connessione)");
}

print("");
print("=== FINE TEST ===");
