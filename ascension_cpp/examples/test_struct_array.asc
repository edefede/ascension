// ============================================================================
// PARTE 10: STRUCT COME DATABASE RECORD
// ============================================================================
print("");
print("═══════ PARTE 10: MINI DATABASE ═══════");

struct Record { id, tipo, valore, timestamp }

// IMPORTANTE: inizializza database e db_size nel main scope
database[0] = 0;  // Crea l'array nel global scope
db_size = 0;

func db_insert(tipo, valore, ts) {
    global db_size;
    rec = new Record();
    rec.id = db_size;
    rec.tipo = tipo;
    rec.valore = valore;
    rec.timestamp = ts;
    database[db_size] = rec;
    db_size += 1;
    return rec.id;
}

func db_find_by_tipo(cerca_tipo) {
    global db_size;
    trovati = 0;
    for (i = 0; i < db_size; i += 1) {
        if (database[i].tipo == cerca_tipo) {
            print("  [", database[i].id, "]", database[i].tipo, "=", database[i].valore);
            trovati += 1;
        }
    }
    return trovati;
}

// Inserisci record
db_insert("temperatura", 22.5, "2026-01-20 10:00");
db_insert("umidita", 65, "2026-01-20 10:00");
db_insert("temperatura", 23.1, "2026-01-20 11:00");
db_insert("pressione", 1013, "2026-01-20 11:00");
db_insert("temperatura", 24.0, "2026-01-20 12:00");
db_insert("umidita", 62, "2026-01-20 12:00");

print("Database con", db_size, "record");
print("");
print("Ricerca 'temperatura':");
n = db_find_by_tipo("temperatura");
print("Trovati:", n, "record");

print("");
print("Ricerca 'umidita':");
n = db_find_by_tipo("umidita");
print("Trovati:", n, "record");

