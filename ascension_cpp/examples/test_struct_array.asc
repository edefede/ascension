struct Prodotto { nome, prezzo, quantita }

// Crea array di prodotti
prodotti[0] = new Prodotto();
prodotti[0].nome = "Laptop";
prodotti[0].prezzo = 999;
prodotti[0].quantita = 5;

prodotti[1] = new Prodotto();
prodotti[1].nome = "Mouse";
prodotti[1].prezzo = 29;
prodotti[1].quantita = 50;

prodotti[2] = new Prodotto();
prodotti[2].nome = "Tastiera";
prodotti[2].prezzo = 79;
prodotti[2].quantita = 30;

prodotti[3] = new Prodotto();
prodotti[3].nome = "Monitor";
prodotti[3].prezzo = 349;
prodotti[3].quantita = 10;

print("Inventario Prodotti:");
print("--------------------------------------------");
totale_valore = 0;
for (i = 0; i < 4; i += 1) {
    valore = prodotti[i].prezzo * prodotti[i].quantita;
    totale_valore += valore;
