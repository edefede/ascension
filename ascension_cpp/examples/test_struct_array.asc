// ============================================================================
// PARTE 5: MATRICI 2D (Array Multidimensionali)
// ============================================================================
print("");
print("═══════ PARTE 5: MATRICI 2D ═══════");

// Crea matrice 3x3 con matrix()
print("Matrice identità 3x3:");
identita = matrix(3, 3, 0);
identita[0,0] = 1;
identita[1,1] = 1;
identita[2,2] = 1;

for (r = 0; r < 3; r += 1) {
    riga = "";
    for (c = 0; c < 3; c += 1) {
        riga = riga + identita[r,c] + " ";
    }
    print("  |", riga, "|");
}

// Matrice manuale con sintassi alternativa arr[i][j]
print("");
print("Matrice 4x4 con numeri progressivi:");
for (r = 0; r < 4; r += 1) {
    for (c = 0; c < 4; c += 1) {
        griglia[r][c] = r * 4 + c + 1;
    }
}

for (r = 0; r < 4; r += 1) {
    riga = "";
    for (c = 0; c < 4; c += 1) {
        val = griglia[r][c];
        if (val < 10) {
            riga = riga + " " + val + " ";
        } else {
            riga = riga + val + " ";
        }
    }
    print("  |", riga, "|");
}

// ============================================================================
// PARTE 6: TABELLONE GIOCO (Matrice di caratteri)
// ============================================================================
print("");
print("═══════ PARTE 6: TABELLONE TRIS ═══════");

// Inizializza tabellone vuoto
board = matrix(3, 3, "-");

// Simula una partita
board[0,0] = "X";
board[1,1] = "O";
board[2,0] = "X";
board[0,2] = "O";
board[1,0] = "X";
board[2,2] = "O";
board[1,2] = "X";

print("Stato partita:");
print("  +---+---+---+");
for (r = 0; r < 3; r += 1) {
    riga = "  |";
    for (c = 0; c < 3; c += 1) {
        riga = riga + " " + board[r,c] + " |";
    }
    print(riga);
    print("  +---+---+---+");
}

// Controlla vincitore (righe)
func check_winner(b) {
    // Controlla righe
    for (r = 0; r < 3; r += 1) {
        if (b[r,0] != "-" && b[r,0] == b[r,1] && b[r,1] == b[r,2]) {
            return b[r,0];
        }
    }
    // Controlla colonne
    for (c = 0; c < 3; c += 1) {
        if (b[0,c] != "-" && b[0,c] == b[1,c] && b[1,c] == b[2,c]) {
            return b[0,c];
        }
    }
    // Diagonali
    if (b[0,0] != "-" && b[0,0] == b[1,1] && b[1,1] == b[2,2]) {
        return b[0,0];
    }
    if (b[0,2] != "-" && b[0,2] == b[1,1] && b[1,1] == b[2,0]) {
        return b[0,2];
    }
    return "-";
}

vincitore = check_winner(board);
if (vincitore != "-") {
    print("Vincitore:", vincitore, "!");
} else {
    print("Nessun vincitore ancora.");
}

