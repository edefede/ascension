// PARTE 7: STRUCT CON ARRAY COME CAMPO
// ============================================================================
print("");
print("═══════ PARTE 7: STRUCT CON ARRAY ═══════");

struct Studente { nome, voti, media }

// Crea studente con voti
alice = new Studente();
alice.nome = "Alice";

// I voti sono in un array separato (simulato con chiavi)
alice_voti[0] = 28;
alice_voti[1] = 30;
alice_voti[2] = 27;
alice_voti[3] = 30;
alice_voti[4] = 29;

// Calcola media
somma_voti = 0;
num_voti = 5;
for (i = 0; i < num_voti; i += 1) {
    somma_voti += alice_voti[i];
}
alice.media = somma_voti / num_voti;

print("Studente:", alice.nome);
print("Voti:", alice_voti[0], alice_voti[1], alice_voti[2], alice_voti[3], alice_voti[4]);
print("Media:", alice.media);

// ============================================================================
// PARTE 8: OPERAZIONI SU MATRICI
// ============================================================================
print("");
print("═══════ PARTE 8: OPERAZIONI SU MATRICI ═══════");

// Crea due matrici 2x2
a = matrix(2, 2, 0);
a[0,0] = 1; a[0,1] = 2;
a[1,0] = 3; a[1,1] = 4;

b = matrix(2, 2, 0);
b[0,0] = 5; b[0,1] = 6;
b[1,0] = 7; b[1,1] = 8;

print("Matrice A:");
print("  |", a[0,0], a[0,1], "|");
print("  |", a[1,0], a[1,1], "|");

print("Matrice B:");
print("  |", b[0,0], b[0,1], "|");
print("  |", b[1,0], b[1,1], "|");

// Somma matrici
c = matrix(2, 2, 0);
for (r = 0; r < 2; r += 1) {
    for (col = 0; col < 2; col += 1) {
        c[r,col] = a[r,col] + b[r,col];
    }
}

print("A + B =");
print("  |", c[0,0], c[0,1], "|");
print("  |", c[1,0], c[1,1], "|");

// Moltiplicazione matrici
d = matrix(2, 2, 0);
for (r = 0; r < 2; r += 1) {
    for (col = 0; col < 2; col += 1) {
        sum = 0;
        for (k = 0; k < 2; k += 1) {
            sum += a[r,k] * b[k,col];
        }
        d[r,col] = sum;
    }
}

print("A * B =");
print("  |", d[0,0], d[0,1], "|");
print("  |", d[1,0], d[1,1], "|");

