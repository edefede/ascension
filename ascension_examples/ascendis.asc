include "strings.asc";
include "array.asc";

// =============================================================================
//  DATABASE GLOBALE
// =============================================================================

global db_store = {};
global db_count = 0;

global DB_VERSION = "1.1";

TYPE_STRING = "string";
TYPE_LIST = "list";
TYPE_HASH = "hash";
TYPE_SET = "set";

QUOTE_CHAR = chr(34);

// =============================================================================
//  FUNZIONI HELPER
// =============================================================================

func db_exists(key) {
    k = keys(db_store);
    n = len(k);
    for (i = 0; i < n; i = i + 1) {
        if (k[i] == key) {
            entry = db_store[key];
            if (entry != NULL) {
                return 1;
            }
        }
    }
    return 0;
}

func db_type(key) {
    if (db_exists(key) == 0) {
        return "none";
    }
    entry = db_store[key];
    return entry["type"];
}

func db_make_string(value) {
    entry = {};
    entry["type"] = TYPE_STRING;
    entry["data"] = value;
    return entry;
}

func db_make_list() {
    entry = {};
    entry["type"] = TYPE_LIST;
    entry["data"] = {};
    entry["len"] = 0;
    return entry;
}

func db_make_hash() {
    entry = {};
    entry["type"] = TYPE_HASH;
    entry["data"] = {};
    return entry;
}

func db_make_set() {
    entry = {};
    entry["type"] = TYPE_SET;
    entry["data"] = {};
    return entry;
}

// =============================================================================
//  COMANDI STRINGHE
// =============================================================================

func cmd_set(key, value) {
    if (db_exists(key) == 0) {
        db_count = db_count + 1;
    }
    db_store[key] = db_make_string(value);
    return "OK";
}

func cmd_get(key) {
    if (db_exists(key) == 0) {
        return "(nil)";
    }
    if (db_type(key) != TYPE_STRING) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    return entry["data"];
}

func cmd_del(key) {
    if (db_exists(key) == 0) {
        return 0;
    }
    db_store[key] = NULL;
    db_count = db_count - 1;
    return 1;
}

func cmd_exists(key) {
    return db_exists(key);
}

func cmd_append(key, value) {
    if (db_exists(key) == 0) {
        cmd_set(key, value);
        return len(value);
    }
    if (db_type(key) != TYPE_STRING) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    new_val = entry["data"] + value;
    entry["data"] = new_val;
    db_store[key] = entry;
    return len(new_val);
}

func cmd_strlen(key) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_STRING) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    return len(entry["data"]);
}

func cmd_incr(key) {
    return cmd_incrby(key, 1);
}

func cmd_decr(key) {
    return cmd_incrby(key, -1);
}

func cmd_incrby(key, amount) {
    if (db_exists(key) == 0) {
        cmd_set(key, "0");
    }
    if (db_type(key) != TYPE_STRING) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    val = to_int(entry["data"]) + amount;
    entry["data"] = "" + val;
    db_store[key] = entry;
    return val;
}

func cmd_decrby(key, amount) {
    return cmd_incrby(key, 0 - amount);
}

// =============================================================================
//  COMANDI LISTE
// =============================================================================

func ensure_list(key) {
    if (db_exists(key) == 0) {
        db_store[key] = db_make_list();
        db_count = db_count + 1;
    }
    return db_type(key) == TYPE_LIST;
}

func cmd_lpush(key, value) {
    if (db_exists(key) == 1) {
        if (db_type(key) != TYPE_LIST) {
            return "(error) WRONGTYPE";
        }
    }
    ensure_list(key);
    entry = db_store[key];
    list_data = entry["data"];
    list_len = entry["len"];
    
    i = list_len;
    while (i > 0) {
        list_data[i] = list_data[i - 1];
        i = i - 1;
    }
    list_data[0] = value;
    
    entry["data"] = list_data;
    entry["len"] = list_len + 1;
    db_store[key] = entry;
    return entry["len"];
}

func cmd_rpush(key, value) {
    if (db_exists(key) == 1) {
        if (db_type(key) != TYPE_LIST) {
            return "(error) WRONGTYPE";
        }
    }
    ensure_list(key);
    entry = db_store[key];
    list_data = entry["data"];
    list_len = entry["len"];
    
    list_data[list_len] = value;
    entry["data"] = list_data;
    entry["len"] = list_len + 1;
    db_store[key] = entry;
    return entry["len"];
}

func cmd_lpop(key) {
    if (db_exists(key) == 0) {
        return "(nil)";
    }
    if (db_type(key) != TYPE_LIST) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    list_len = entry["len"];
    if (list_len == 0) {
        return "(nil)";
    }
    
    list_data = entry["data"];
    value = list_data[0];
    
    for (i = 0; i < list_len - 1; i = i + 1) {
        list_data[i] = list_data[i + 1];
    }
    list_data[list_len - 1] = NULL;
    
    entry["data"] = list_data;
    entry["len"] = list_len - 1;
    db_store[key] = entry;
    return value;
}

func cmd_rpop(key) {
    if (db_exists(key) == 0) {
        return "(nil)";
    }
    if (db_type(key) != TYPE_LIST) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    list_len = entry["len"];
    if (list_len == 0) {
        return "(nil)";
    }
    
    list_data = entry["data"];
    value = list_data[list_len - 1];
    list_data[list_len - 1] = NULL;
    
    entry["data"] = list_data;
    entry["len"] = list_len - 1;
    db_store[key] = entry;
    return value;
}

func cmd_llen(key) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_LIST) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    return entry["len"];
}

func cmd_lindex(key, index) {
    if (db_exists(key) == 0) {
        return "(nil)";
    }
    if (db_type(key) != TYPE_LIST) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    list_len = entry["len"];
    
    if (index < 0) {
        index = list_len + index;
    }
    if (index < 0) {
        return "(nil)";
    }
    if (index >= list_len) {
        return "(nil)";
    }
    
    list_data = entry["data"];
    return list_data[index];
}

func cmd_lrange(key, start, stop) {
    result = {};
    if (db_exists(key) == 0) {
        return result;
    }
    if (db_type(key) != TYPE_LIST) {
        return result;
    }
    entry = db_store[key];
    list_len = entry["len"];
    list_data = entry["data"];
    
    if (start < 0) {
        start = list_len + start;
    }
    if (stop < 0) {
        stop = list_len + stop;
    }
    if (start < 0) {
        start = 0;
    }
    if (stop >= list_len) {
        stop = list_len - 1;
    }
    
    idx = 0;
    for (i = start; i <= stop; i = i + 1) {
        result[idx] = list_data[i];
        idx = idx + 1;
    }
    return result;
}

// =============================================================================
//  COMANDI HASH
// =============================================================================

func ensure_hash(key) {
    if (db_exists(key) == 0) {
        db_store[key] = db_make_hash();
        db_count = db_count + 1;
    }
    return db_type(key) == TYPE_HASH;
}

func cmd_hset(key, field, value) {
    if (db_exists(key) == 1) {
        if (db_type(key) != TYPE_HASH) {
            return "(error) WRONGTYPE";
        }
    }
    ensure_hash(key);
    entry = db_store[key];
    hash_data = entry["data"];
    
    is_new = 1;
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    for (i = 0; i < hlen; i = i + 1) {
        if (hkeys[i] == field) {
            is_new = 0;
            break;
        }
    }
    
    hash_data[field] = value;
    entry["data"] = hash_data;
    db_store[key] = entry;
    return is_new;
}

func cmd_hget(key, field) {
    if (db_exists(key) == 0) {
        return "(nil)";
    }
    if (db_type(key) != TYPE_HASH) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    hash_data = entry["data"];
    
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    for (i = 0; i < hlen; i = i + 1) {
        if (hkeys[i] == field) {
            return hash_data[field];
        }
    }
    return "(nil)";
}

func cmd_hdel(key, field) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_HASH) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    hash_data = entry["data"];
    
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    for (i = 0; i < hlen; i = i + 1) {
        if (hkeys[i] == field) {
            hash_data[field] = NULL;
            entry["data"] = hash_data;
            db_store[key] = entry;
            return 1;
        }
    }
    return 0;
}

func cmd_hgetall(key) {
    result = {};
    if (db_exists(key) == 0) {
        return result;
    }
    if (db_type(key) != TYPE_HASH) {
        return result;
    }
    entry = db_store[key];
    hash_data = entry["data"];
    
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    idx = 0;
    for (i = 0; i < hlen; i = i + 1) {
        field = hkeys[i];
        val = hash_data[field];
        if (val != NULL) {
            result[idx] = field;
            result[idx + 1] = val;
            idx = idx + 2;
        }
    }
    return result;
}

func cmd_hkeys(key) {
    result = {};
    if (db_exists(key) == 0) {
        return result;
    }
    if (db_type(key) != TYPE_HASH) {
        return result;
    }
    entry = db_store[key];
    hash_data = entry["data"];
    
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    idx = 0;
    for (i = 0; i < hlen; i = i + 1) {
        field = hkeys[i];
        if (hash_data[field] != NULL) {
            result[idx] = field;
            idx = idx + 1;
        }
    }
    return result;
}

func cmd_hlen(key) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_HASH) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    hash_data = entry["data"];
    
    count = 0;
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    for (i = 0; i < hlen; i = i + 1) {
        if (hash_data[hkeys[i]] != NULL) {
            count = count + 1;
        }
    }
    return count;
}

func cmd_hexists(key, field) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_HASH) {
        return 0;
    }
    entry = db_store[key];
    hash_data = entry["data"];
    
    hkeys = keys(hash_data);
    hlen = len(hkeys);
    for (i = 0; i < hlen; i = i + 1) {
        if (hkeys[i] == field) {
            if (hash_data[field] != NULL) {
                return 1;
            }
        }
    }
    return 0;
}

// =============================================================================
//  COMANDI SET (INSIEMI)
// =============================================================================

func ensure_set(key) {
    if (db_exists(key) == 0) {
        db_store[key] = db_make_set();
        db_count = db_count + 1;
    }
    return db_type(key) == TYPE_SET;
}

func cmd_sadd(key, member) {
    if (db_exists(key) == 1) {
        if (db_type(key) != TYPE_SET) {
            return "(error) WRONGTYPE";
        }
    }
    ensure_set(key);
    entry = db_store[key];
    set_data = entry["data"];
    
    skeys = keys(set_data);
    slen = len(skeys);
    for (i = 0; i < slen; i = i + 1) {
        if (skeys[i] == member) {
            if (set_data[member] == 1) {
                return 0;
            }
        }
    }
    
    set_data[member] = 1;
    entry["data"] = set_data;
    db_store[key] = entry;
    return 1;
}

func cmd_srem(key, member) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_SET) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    set_data = entry["data"];
    
    skeys = keys(set_data);
    slen = len(skeys);
    for (i = 0; i < slen; i = i + 1) {
        if (skeys[i] == member) {
            if (set_data[member] == 1) {
                set_data[member] = NULL;
                entry["data"] = set_data;
                db_store[key] = entry;
                return 1;
            }
        }
    }
    return 0;
}

func cmd_sismember(key, member) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_SET) {
        return 0;
    }
    entry = db_store[key];
    set_data = entry["data"];
    
    skeys = keys(set_data);
    slen = len(skeys);
    for (i = 0; i < slen; i = i + 1) {
        if (skeys[i] == member) {
            if (set_data[member] == 1) {
                return 1;
            }
        }
    }
    return 0;
}

func cmd_smembers(key) {
    result = {};
    if (db_exists(key) == 0) {
        return result;
    }
    if (db_type(key) != TYPE_SET) {
        return result;
    }
    entry = db_store[key];
    set_data = entry["data"];
    
    skeys = keys(set_data);
    slen = len(skeys);
    idx = 0;
    for (i = 0; i < slen; i = i + 1) {
        if (set_data[skeys[i]] == 1) {
            result[idx] = skeys[i];
            idx = idx + 1;
        }
    }
    return result;
}

func cmd_scard(key) {
    if (db_exists(key) == 0) {
        return 0;
    }
    if (db_type(key) != TYPE_SET) {
        return "(error) WRONGTYPE";
    }
    entry = db_store[key];
    set_data = entry["data"];
    
    count = 0;
    skeys = keys(set_data);
    slen = len(skeys);
    for (i = 0; i < slen; i = i + 1) {
        if (set_data[skeys[i]] == 1) {
            count = count + 1;
        }
    }
    return count;
}

// =============================================================================
//  COMANDI GENERALI
// =============================================================================

func cmd_keys(pattern) {
    result = {};
    idx = 0;
    
    k = keys(db_store);
    n = len(k);
    for (i = 0; i < n; i = i + 1) {
        key = k[i];
        entry = db_store[key];
        if (entry != NULL) {
            if (pattern == "*") {
                result[idx] = key;
                idx = idx + 1;
            } else {
                if (str_ends_with(pattern, "*")) {
                    prefix = substr(pattern, 0, len(pattern) - 1);
                    if (str_starts_with(key, prefix)) {
                        result[idx] = key;
                        idx = idx + 1;
                    }
                } else {
                    if (key == pattern) {
                        result[idx] = key;
                        idx = idx + 1;
                    }
                }
            }
        }
    }
    return result;
}

func cmd_type(key) {
    return db_type(key);
}

func cmd_rename(oldkey, newkey) {
    if (db_exists(oldkey) == 0) {
        return "(error) no such key";
    }
    entry = db_store[oldkey];
    db_store[oldkey] = NULL;
    db_store[newkey] = entry;
    return "OK";
}

func cmd_dbsize() {
    return db_count;
}

func cmd_flushdb() {
    db_store = {};
    db_count = 0;
    return "OK";
}

// =============================================================================
//  PARSER COMANDI (semplificato)
// =============================================================================

func parse_command(line) {
    result = {};
    idx = 0;
    current = "";
    in_quote = 0;
    
    n = len(line);
    i = 0;
    while (i < n) {
        c = line[i];
        
        // Gestione virgolette
        if (c == QUOTE_CHAR) {
            in_quote = 1 - in_quote;
            i = i + 1;
        } else {
            // Gestione spazi (solo fuori dalle virgolette)
            is_sep = 0;
            if (c == " ") {
                is_sep = 1;
            }
            if (c == chr(9)) {
                is_sep = 1;
            }
            
            if (is_sep == 1) {
                if (in_quote == 0) {
                    if (len(current) > 0) {
                        result[idx] = current;
                        idx = idx + 1;
                        current = "";
                    }
                } else {
                    current = current + c;
                }
            } else {
                current = current + c;
            }
            i = i + 1;
        }
    }
    
    if (len(current) > 0) {
        result[idx] = current;
    }
    
    return result;
}

func format_array(arr) {
    n = len(arr);
    if (n == 0) {
        return "(empty array)";
    }
    
    result = "";
    for (i = 0; i < n; i = i + 1) {
        num = i + 1;
        result = result + num + ") " + arr[i] + "\n";
    }
    return str_rtrim(result);
}

func get_help() {
    h = "AscendisDB Commands:\n";
    h = h + "  STRING: SET GET DEL EXISTS APPEND STRLEN INCR DECR INCRBY DECRBY\n";
    h = h + "  LIST:   LPUSH RPUSH LPOP RPOP LLEN LINDEX LRANGE\n";
    h = h + "  HASH:   HSET HGET HDEL HGETALL HKEYS HLEN HEXISTS\n";
    h = h + "  SET:    SADD SREM SISMEMBER SMEMBERS SCARD\n";
    h = h + "  KEYS:   KEYS TYPE RENAME DBSIZE FLUSHDB\n";
    h = h + "  OTHER:  PING ECHO INFO HELP QUIT\n";
    return h;
}

// =============================================================================
//  ESECUZIONE COMANDI
// =============================================================================

func execute_command(line) {
    tokens = parse_command(str_trim(line));
    argc = len(tokens);
    
    if (argc == 0) {
        return "";
    }
    
    cmd = str_upper(tokens[0]);
    
    // --- COMANDI GENERALI ---
    if (cmd == "PING") {
        if (argc > 1) {
            return tokens[1];
        }
        return "PONG";
    }
    
    if (cmd == "ECHO") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return tokens[1];
    }
    
    if (cmd == "INFO") {
        info = "# AscendisDB\n";
        info = info + "version:" + DB_VERSION + "\n";
        info = info + "keys:" + db_count + "\n";
        return info;
    }
    
    if (cmd == "DBSIZE") {
        return cmd_dbsize();
    }
    
    if (cmd == "FLUSHDB") {
        return cmd_flushdb();
    }
    
    if (cmd == "HELP") {
        return get_help();
    }
    
    // --- COMANDI STRINGHE ---
    if (cmd == "SET") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_set(tokens[1], tokens[2]);
    }
    
    if (cmd == "GET") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_get(tokens[1]);
    }
    
    if (cmd == "DEL") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        deleted = 0;
        for (i = 1; i < argc; i = i + 1) {
            deleted = deleted + cmd_del(tokens[i]);
        }
        return deleted;
    }
    
    if (cmd == "EXISTS") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_exists(tokens[1]);
    }
    
    if (cmd == "APPEND") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_append(tokens[1], tokens[2]);
    }
    
    if (cmd == "STRLEN") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_strlen(tokens[1]);
    }
    
    if (cmd == "INCR") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_incr(tokens[1]);
    }
    
    if (cmd == "DECR") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_decr(tokens[1]);
    }
    
    if (cmd == "INCRBY") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_incrby(tokens[1], to_int(tokens[2]));
    }
    
    if (cmd == "DECRBY") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_decrby(tokens[1], to_int(tokens[2]));
    }
    
    // --- COMANDI LISTE ---
    if (cmd == "LPUSH") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_lpush(tokens[1], tokens[2]);
    }
    
    if (cmd == "RPUSH") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_rpush(tokens[1], tokens[2]);
    }
    
    if (cmd == "LPOP") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_lpop(tokens[1]);
    }
    
    if (cmd == "RPOP") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_rpop(tokens[1]);
    }
    
    if (cmd == "LLEN") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_llen(tokens[1]);
    }
    
    if (cmd == "LINDEX") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_lindex(tokens[1], to_int(tokens[2]));
    }
    
    if (cmd == "LRANGE") {
        if (argc < 4) {
            return "(error) wrong number of arguments";
        }
        result = cmd_lrange(tokens[1], to_int(tokens[2]), to_int(tokens[3]));
        return format_array(result);
    }
    
    // --- COMANDI HASH ---
    if (cmd == "HSET") {
        if (argc < 4) {
            return "(error) wrong number of arguments";
        }
        return cmd_hset(tokens[1], tokens[2], tokens[3]);
    }
    
    if (cmd == "HGET") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_hget(tokens[1], tokens[2]);
    }
    
    if (cmd == "HDEL") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_hdel(tokens[1], tokens[2]);
    }
    
    if (cmd == "HGETALL") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        result = cmd_hgetall(tokens[1]);
        return format_array(result);
    }
    
    if (cmd == "HKEYS") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        result = cmd_hkeys(tokens[1]);
        return format_array(result);
    }
    
    if (cmd == "HLEN") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_hlen(tokens[1]);
    }
    
    if (cmd == "HEXISTS") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_hexists(tokens[1], tokens[2]);
    }
    
    // --- COMANDI SET ---
    if (cmd == "SADD") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_sadd(tokens[1], tokens[2]);
    }
    
    if (cmd == "SREM") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_srem(tokens[1], tokens[2]);
    }
    
    if (cmd == "SISMEMBER") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_sismember(tokens[1], tokens[2]);
    }
    
    if (cmd == "SMEMBERS") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        result = cmd_smembers(tokens[1]);
        return format_array(result);
    }
    
    if (cmd == "SCARD") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_scard(tokens[1]);
    }
    
    // --- ALTRI COMANDI ---
    if (cmd == "KEYS") {
        pattern = "*";
        if (argc >= 2) {
            pattern = tokens[1];
        }
        result = cmd_keys(pattern);
        return format_array(result);
    }
    
    if (cmd == "TYPE") {
        if (argc < 2) {
            return "(error) wrong number of arguments";
        }
        return cmd_type(tokens[1]);
    }
    
    if (cmd == "RENAME") {
        if (argc < 3) {
            return "(error) wrong number of arguments";
        }
        return cmd_rename(tokens[1], tokens[2]);
    }
    
    if (cmd == "QUIT") {
        return "QUIT";
    }
    
    if (cmd == "EXIT") {
        return "QUIT";
    }
    
    return "(error) unknown command: " + tokens[0];
}

// =============================================================================
//  CLI INTERATTIVA
// =============================================================================

func run_cli() {
    print("===========================================");
    print("  AscendisDB v" + DB_VERSION + " - Mini Redis Clone");
    print("  Type HELP for commands, QUIT to exit");
    print("===========================================");
    
    running = 1;
    while (running) {
        line = read();
        
        trimmed = str_trim(line);
        if (len(trimmed) == 0) {
            running = 0;
        } else {
            response = execute_command(line);
            
            if (response == "QUIT") {
                print("Bye!");
                running = 0;
            } else {
                if (len(response) > 0) {
                    print(response);
                }
            }
        }
    }
}

// =============================================================================
//  SERVER TCP
// =============================================================================

global SERVER_PORT = 6380;
global server_running = 0;

func handle_client(client) {
    // Invia messaggio di benvenuto
    welcome = "AscendisDB v" + DB_VERSION + " ready\r\n";
    socket_send(client, welcome);
    
    buffer = "";
    client_active = 1;
    
    while (client_active) {
        // Ricevi dati
        data = socket_recv(client, 1024);
        
        if (data == NULL) {
            client_active = 0;
        } else {
            if (len(data) == 0) {
                client_active = 0;
            } else {
                // Aggiungi al buffer
                buffer = buffer + data;
                
                // Processa tutte le linee complete nel buffer
                newline_pos = str_index_of(buffer, "\n");
                while (newline_pos >= 0) {
                    // Estrai la linea
                    line = substr(buffer, 0, newline_pos);
                    // Rimuovi \r se presente
                    if (len(line) > 0) {
                        last_char = line[len(line) - 1];
                        if (last_char == chr(13)) {
                            line = substr(line, 0, len(line) - 1);
                        }
                    }
                    
                    // Aggiorna buffer (rimuovi la linea processata)
                    buffer = substr(buffer, newline_pos + 1, len(buffer) - newline_pos - 1);
                    
                    // Processa il comando
                    line = str_trim(line);
                    if (len(line) > 0) {
                        response = execute_command(line);
                        
                        if (response == "QUIT") {
                            socket_send(client, "Bye!\r\n");
                            client_active = 0;
                        } else {
                            if (response == "SHUTDOWN") {
                                socket_send(client, "Server shutting down...\r\n");
                                client_active = 0;
                                server_running = 0;
                            } else {
                                // Invia risposta
                                socket_send(client, response + "\r\n");
                            }
                        }
                    }
                    
                    // Cerca prossima newline
                    if (client_active) {
                        newline_pos = str_index_of(buffer, "\n");
                    } else {
                        newline_pos = -1;
                    }
                }
            }
        }
    }
    
    socket_close(client);
    print("Client disconnected");
}

func run_server() {
    print("===========================================");
    print("  AscendisDB v" + DB_VERSION + " - TCP Server Mode");
    print("  Starting on port " + SERVER_PORT + "...");
    print("===========================================");
    
    server = socket_open("TCP", "IPv4");
    if (server == NULL) {
        print("ERROR: Failed to create socket");
        return;
    }
    
    result = socket_bind(server, "0.0.0.0", SERVER_PORT);
    if (result == NULL) {
        print("ERROR: Failed to bind to port " + SERVER_PORT);
        socket_close(server);
        return;
    }
    
    result = socket_listen(server, 5);
    if (result == NULL) {
        print("ERROR: Failed to listen");
        socket_close(server);
        return;
    }
    
    print("Server ready. Listening on port " + SERVER_PORT);
    print("Connect with: nc localhost " + SERVER_PORT);
    print("Or: telnet localhost " + SERVER_PORT);
    print("Send SHUTDOWN to stop server");
    print("");
    
    server_running = 1;
    while (server_running) {
        print("Waiting for connection...");
        client = socket_accept(server);
        
        if (client != NULL) {
            print("Client connected!");
            handle_client(client);
        }
    }
    
    socket_close(server);
    print("Server stopped.");
}

// =============================================================================
//  MAIN - Scegli modalità
// =============================================================================

// Per CLI interattiva:
run_cli();

// Per server TCP, commenta run_cli() sopra e decommenta:
// run_server();
